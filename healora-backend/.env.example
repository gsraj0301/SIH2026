# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` — add it to .gitignore.

# PostgreSQL connection string.
# Retro Remote Supabase (hosted Postgres) — Session pooler (preferred: resolves to IPv4):
#   user is "postgres.<project-ref>", host aws-0-<region>.pooler.supabase.com, password URL-encoded.
#   NOTE: the direct host db.<ref>.supabase.co can resolve IPv6-ONLY on some networks (with no
#   working IPv6 route) — that is unreachable; use the pooler host instead.
DATABASE_URL="postgresql://postgres.<project-ref>:<YOUR_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# Retro Local Postgres fallback (for offline demo):
# DATABASE_URL="postgresql://postgres:<password>@localhost:5432/healora"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"

# URL of the teammate's voice microservice (transcription + triage)
VOICE_SERVICE_URL="http://localhost:4000"

# Port for this backend
PORT=3000